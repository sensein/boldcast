# Rendered Marp output (HTML + PDF are shipped as archival snapshot; PPTX is not)
seed_pitch.pptx

# Animated figures (regenerable from build_figures.py; static PNGs are shipped)
figures/*.gif

# Marp preview thumbnails (regenerable)
preview/

# Demo runtime assets (regenerable from demo/build_demo_assets.py)
demo/cortex_*.png
demo/patch_meta.json
demo/_palette.npy

# Python cache (also caught by root .gitignore, explicit here for safety)
__pycache__/

# Local rehearsal / design-handoff artifacts (not part of the shipped deck)
claude_design_prompts.md
speaker_script.md
